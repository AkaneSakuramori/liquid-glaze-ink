# ═══════════════════════════════════════════════════════════════════════════════
# XTRATOON ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ─── SUPABASE (Required) ───────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your_project_id

# ─── NAPAEXTRA / TGDRIVE CDN (Required for uploads) ───────────────────────────
# These are set as Supabase Edge Function secrets in your project dashboard:
#   NAPAEXTRA_URL=https://your-tgdrive-instance.koyeb.app
#   NAPAEXTRA_PASSWORD=your_admin_password

# ─── TELEGRAM (Set as Supabase Edge Function secrets) ──────────────────────────
#   TELEGRAM_BOT_TOKEN=your_telegram_bot_token
#   TELEGRAM_CHANNEL_ID=your_main_channel_id
#   TELEGRAM_COMMENT_CHANNEL_ID=your_comment_channel_id
#   TELEGRAM_COMMUNITY_CHANNEL_ID=your_community_channel_id

# ─── SMTP (Set as Supabase Edge Function secrets) ─────────────────────────────
#   SMTP_USER=your_smtp_email
#   SMTP_PASS=your_smtp_password
