# ═══════════════════════════════════════════════════════════════════════════════
# XTRATOON ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════════════════

# ─── SUPABASE (Required) ───────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your_project_id

# ─── NAPAEXTRA / TGDRIVE CDN (Required for uploads) ───────────────────────────
VITE_NAPAEXTRA_URL=https://your-tgdrive-instance.koyeb.app
VITE_NAPAEXTRA_PASSWORD=your_admin_password

# ─── TELEGRAM ─────────────────────────────────────────────────────────────────
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
VITE_TELEGRAM_CHANNEL_ID=your_main_channel_id
VITE_TELEGRAM_COMMENT_CHANNEL_ID=your_comment_channel_id
VITE_TELEGRAM_COMMUNITY_CHANNEL_ID=your_community_channel_id

# ─── SMTP (for email edge functions) ──────────────────────────────────────────
VITE_SMTP_USER=your_smtp_email
VITE_SMTP_PASS=your_smtp_password
